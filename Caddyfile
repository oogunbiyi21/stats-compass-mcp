mcp.statscompass.io {
    # CORS headers - critical for browser-based MCP clients (like Claude.ai)
    # Must expose mcp-session-id so clients can read and send it back
    # Note: Use lowercase to match what mcp-python-sdk actually sends
    header {
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Accept, mcp-session-id, mcp-protocol-version, Authorization"
        Access-Control-Expose-Headers "mcp-session-id"
    }

    # Handle preflight OPTIONS requests
    @options method OPTIONS
    handle @options {
        respond 204
    }

    reverse_proxy stats-compass:8000
}
